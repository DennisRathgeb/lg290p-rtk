#!/usr/bin/env bash
# Fast checks on staged files only: clang-format and include guards on C++, bash -n on shell.
set -euo pipefail
# NUL-separated names of staged (added, copied, modified) files matching the patterns.
staged() { git diff --cached --name-only --diff-filter=ACM -z -- "$@"; }
if command -v clang-format >/dev/null; then
  staged '*.h' '*.cc' | xargs -0 -r clang-format --dry-run --Werror
fi
if [ -n "$(staged '*.h' '*.cc' | tr -d '\0')" ]; then
  python3 tools/check-header-guards.py
fi
staged '*.sh' 'tools/githooks/*' | xargs -0 -r -n 1 bash -n

PROJECT_NAME           = "lgrtk"
PROJECT_NUMBER         = 0.2.0
PROJECT_BRIEF          = "Linux toolkit for the Quectel LG290P RTK GNSS receiver"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/lgrtk docs/api.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api.md
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXCLUDE_SYMBOLS        = lgrtk::Projection::Impl
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = build/docs/doxygen.log
PREDEFINED             = LGRTK_HAVE_PROJ=1
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = NO
HAVE_DOT               = NO
